# [CONFIGURAR] Preencha com suas credenciais reais

# Atlassian (Jira + Confluence)
ATLASSIAN_URL=https://olxbr.atlassian.net
ATLASSIAN_EMAIL=[SEU_EMAIL]
ATLASSIAN_TOKEN=[SEU_TOKEN_ATLASSIAN]
JIRA_PROJECT=[PROJETO_JIRA]

# Slack
SLACK_BOT_TOKEN=[SEU_SLACK_BOT_TOKEN]

# PostgreSQL (preenchido automaticamente pelo bridge)
PG_DEFAULT_HOST=[HOST_POSTGRES_DEFAULT]
PG_DEFAULT_DB=[DB_NAME_DEFAULT]
PG_DEFAULT_USER=[USER_POSTGRES]
PG_DEFAULT_PASSWORD=[PASSWORD_POSTGRES]

PG_VEHICLE_HISTORY_HOST=[HOST_POSTGRES_VH]
PG_VEHICLE_HISTORY_DB=[DB_NAME_VH]
PG_VEHICLE_HISTORY_USER=[USER_POSTGRES_VH]
PG_VEHICLE_HISTORY_PASSWORD=[PASSWORD_POSTGRES_VH]

# Trino
TRINO_HOST=[HOST_TRINO]
TRINO_USER=[USER_TRINO]
TRINO_PASSWORD=[PASSWORD_TRINO]

# Figma (opcional - para VanGogh)
FIGMA_TOKEN=[SEU_FIGMA_TOKEN]
